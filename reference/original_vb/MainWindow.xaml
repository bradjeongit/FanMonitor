<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BLDC_MOTOR_MONITOR"
        mc:Ignorable="d"
        Icon="/images/motor.ico"
        Title="BLDC MOTOR MONITOR" MinHeight="650" MinWidth="1000" >
    <Window.Resources>

        <!--#region LISTVIEW스타일 -->
        <Style TargetType="ListView">
            <Setter Property="Margin" Value="5 0"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="항목 더블클릭시 수정/삭제"/>
        </Style>
        <!--#endregion-->
                        
        <!--리스트뷰에 사용되는 상태 열 구성 템플릿-->
        <DataTemplate x:Key="StatusTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="35"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Width="20" Height="20">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding STATUS}" Value="0">
                                    <Setter Property="Source" Value="/images/good.png"/>
                                    <Setter Property="ToolTip" Value="정상"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding STATUS}" Value="1">
                                    <Setter Property="Source" Value="/images/bad.png"/>
                                    <Setter Property="ToolTip" Value="이상"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding STATUS}" Value="2">
                                    <Setter Property="Source" Value="/images/nouse.png"/>
                                    <Setter Property="ToolTip" Value="중지(사용안함)"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
                <Label Grid.Column="1" HorizontalContentAlignment="Right">
                    <Label.Style>
                        <Style TargetType="Label">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding STATUS}" Value="0">
                                    <Setter Property="Content" Value="{Binding RPM}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding STATUS}" Value="1">
                                    <Setter Property="Content" Value="이상"/>
                                    <Setter Property="Foreground" Value="Red"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding STATUS}" Value="2">
                                    <Setter Property="Content" Value="중지"/>
                                    <Setter Property="Foreground" Value="LightGray"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding STATUS}" Value="9">
                                    <Setter Property="Content" Value="대기"/>
                                    <Setter Property="Foreground" Value="LightGray"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Label.Style>
                </Label>
            </Grid>
            
        </DataTemplate>

        <!--리스트뷰에 사용되는 모터 타입 열 이미지 구성 템플릿-->
        <DataTemplate x:Key="MotorTypeTemplate">
            <StackPanel Orientation="Horizontal">
                <Image Width="20" Height="20" Stretch="Fill" >
                    <Image.Style>
                        <!--#region 모터종류그림템플릿 -->
                        <Style TargetType="Image">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MType}" Value="0">
                                    <Setter Property="Source" Value="/images/oldmotor.png"/>
                                    <Setter Property="ToolTip" Value="기존모터"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding MType}" Value="1">
                                    <Setter Property="Source" Value="/images/newmotor.png"/>
                                    <Setter Property="ToolTip" Value="신규모터"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                        <!--#endregion-->
                    </Image.Style>
                </Image>
            </StackPanel>
        </DataTemplate>

        <!--설정 버튼 스타일-->
        <Style x:Key="SettingsTemplate" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Image Source="/images/settings.png" Width="22" Height="22" ToolTip="설정"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Cursor" Value="Hand"/>
            <EventSetter Event="Click" Handler="Btn_Setting_Click"/>
        </Style>

        <!--설정 버튼 스타일 -->
        <Style x:Key="AddTemplate" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Image Source="/images/add.png" Width="22" Height="22" ToolTip="추가"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Cursor" Value="Hand"/>
            <EventSetter Event="Click" Handler="Btn_Add_Click"/>
        </Style>

        <!-- 탭 선택/비선택 모양 스타일-->
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border  Name="Border" Margin="0,0,-4,0" BorderThickness="0" CornerRadius="2,12,0,0" >
                                <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" Margin="12,2,12,2" RecognizesAccessKey="True"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Panel.ZIndex" Value="100" />
                                <Setter TargetName="Border" Property="Background" Value="#16a085" />
                                <Setter TargetName="ContentSite" Property="TextElement.Foreground" Value="white" />
                                <Setter TargetName="ContentSite" Property="TextElement.FontWeight" Value="DemiBold" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="LightGray" />
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 제어 시작 템플릿 스타일-->
        <ControlTemplate x:Key="StartButton" TargetType="Button">
            <Border Name="bg" CornerRadius="5" BorderThickness="1" BorderBrush="DarkGray" Background="white">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Polygon Name="shape" Points="0,1 6,6 0,11" Fill="#2980b9" Stroke="DarkGray" StrokeThickness="0" VerticalAlignment="Center" Margin="5 0 5 1"/>
                    <ContentPresenter Name="cp" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bg" Property="Background" Value="#2980b9" />
                    <Setter TargetName="shape" Property="Fill" Value="white" />
                    <Setter TargetName="cp" Property="TextElement.Foreground" Value="white" />
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <!-- 제어 종료 템플릿 스타일-->
        <ControlTemplate x:Key="StopButton" TargetType="Button">
            <Border Name="bg" CornerRadius="5" BorderThickness="1" BorderBrush="DarkGray" Background="white">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Rectangle Name="shape" Width="10" Height="10" Fill="#c0392b" Margin="5 1 5 0"/>
                    <ContentPresenter Name="cp" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bg" Property="Background" Value="#c0392b" />
                    <Setter TargetName="shape" Property="Fill" Value="white" />
                    <Setter TargetName="cp" Property="TextElement.Foreground" Value="white" />
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0"/> <!--숨겨놓음-->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Button Content="test" Template="{DynamicResource NormalButtonTemplate}"/>
            <Button Content="test" Template="{DynamicResource SubmitButtonTemplate}"/>
            <Button Content="test" Template="{DynamicResource AlertButtonTemplate}"/>

        </StackPanel>
        
