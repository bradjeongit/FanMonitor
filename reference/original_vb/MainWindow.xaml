                                <RowDefinition Height ="*"/>
                            </Grid.RowDefinitions>

                            <!-- 구역 타이틀 -->
                            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" CornerRadius="3" Background="#34495e" Margin="0 3">
                                <TextBlock HorizontalAlignment="Center" Margin="0 3" Foreground="white" FontWeight="DemiBold">1구역</TextBlock>
                            </Border>

                            <!--#region 온실1-1구역 짝수 영역 -->

                            <Grid Grid.Row="1" Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="1*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Row="0" Grid.Column="0" CornerRadius="5" Grid.RowSpan="3" Background="#f39c12" Margin="5 0 0 2">
                                    <Label HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White">짝</Label>
                                </Border>
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="5 0 0 0">
                                    <Image Source="/images/oldmotor.png" Width="15" Height="15" ToolTip="기존모터"/>
                                    <Rectangle x:Name="rec_H1R1E_SOURCE_NETSTATUS" Width="10" Height="10" RadiusX="10" RadiusY="10" Margin="5 0 0 0" Fill="Gray"/>
                                    <TextBlock x:Name="H1R1E_lbl_old_ip" Margin="5 0 0 0">-</TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="5 0 0 0">
                                    <Image Source="/images/newmotor.png" Width="15" Height="15" ToolTip="신규모터"/>
                                    <Rectangle x:Name="rec_H1R1E_TARGET_NETSTATUS" Width="10" Height="10" RadiusX="10" RadiusY="10" Margin="5 0 0 0" Fill="Gray"/>
                                    <TextBlock x:Name="H1R1E_lbl_new_ip" Margin="5 0 0 0">-</TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="5 0 0 0">
                                    <TextBlock Width="15">┖</TextBlock>
                                    <Rectangle x:Name="rec_H1R1E_SID_NETSTATUS" Width="10" Height="10" RadiusX="10" RadiusY="10" Margin="5 0 0 0" Fill="Gray"/>
                                    <TextBlock x:Name="H1R1E_lbl_source" VerticalAlignment="Top" Margin="5 0 0 0" >-</TextBlock>
                                </StackPanel>
                                <Button x:Name="Btn_Settings_H1R1E" Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" VerticalAlignment="Top" Style="{StaticResource SettingsTemplate}"/>
                                <Button x:Name="Btn_Add_H1R1E" Grid.Row="1" Grid.Column="2" Grid.RowSpan="2" VerticalAlignment="Bottom" Style="{StaticResource AddTemplate}"/>
                            </Grid>

                            <ListView x:Name="LV_H1R1E" Grid.Row="2" Grid.Column="0" GridViewColumnHeader.Click="lvHeader_CLICK" MouseDoubleClick="Lv_DBClick" SizeChanged="ListView_SizeChanged">
                                <ListView.View>
                                    <GridView>
                                        <GridView.Columns>
                                            <GridViewColumn Header="" Width="35" CellTemplate="{StaticResource MotorTypeTemplate}"  />
                                            <GridViewColumn Header="ID" Width="50">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Label Content="{Binding ID}" HorizontalContentAlignment="Center"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="상태" Width="150" CellTemplate="{StaticResource StatusTemplate}"/>
                                        </GridView.Columns>
                                    </GridView>
                                </ListView.View>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>
                            <!--#endregion-->

                            <!--#region 온실1-1구역 홀수 영역 -->
                            <Grid Grid.Row="1" Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="1*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Row="0" Grid.Column="0" CornerRadius="5" Grid.RowSpan="3" Background="#2980b9" Margin="5 0 0 2">
                                    <Label HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White">홀</Label>
                                </Border>
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="5 0 0 0">
                                    <Image Source="/images/oldmotor.png" Width="15" Height="15" ToolTip="기존모터"/>
                                    <Rectangle x:Name="rec_H1R1O_SOURCE_NETSTATUS" Width="10" Height="10" RadiusX="10" RadiusY="10" Margin="5 0 0 0" Fill="Gray"/>
                                    <TextBlock x:Name="H1R1O_lbl_old_ip" Margin="5 0 0 0">-</TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="5 0 0 0">
                                    <Image Source="/images/newmotor.png" Width="15" Height="15" ToolTip="신규모터"/>
                                    <Rectangle x:Name="rec_H1R1O_TARGET_NETSTATUS" Width="10" Height="10" RadiusX="10" RadiusY="10" Margin="5 0 0 0" Fill="Gray"/>
                                    <TextBlock x:Name="H1R1O_lbl_new_ip" Margin="5 0 0 0">-</TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="5 0 0 0">
                                    <TextBlock Width="15">┖</TextBlock>
                                    <Rectangle x:Name="rec_H1R1O_SID_NETSTATUS" Width="10" Height="10" RadiusX="10" RadiusY="10" Margin="5 0 0 0" Fill="gray"/>
                                    <TextBlock x:Name="H1R1O_lbl_source" VerticalAlignment="Top" Margin="5 0 0 0" >-</TextBlock>
                                </StackPanel>
                                <Button x:Name="Btn_Settings_H1R1O" Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" VerticalAlignment="Top" Style="{StaticResource SettingsTemplate}"/>
                                <Button x:Name="Btn_Add_H1R1O" Grid.Row="1" Grid.Column="2" Grid.RowSpan="2" VerticalAlignment="Bottom" Style="{StaticResource AddTemplate}"/>
                            </Grid>

                            <ListView x:Name="LV_H1R1O" Grid.Row="2" Grid.Column="1" GridViewColumnHeader.Click="lvHeader_CLICK" MouseDoubleClick="Lv_DBClick" SizeChanged="ListView_SizeChanged">

                                <ListView.View>
                                    <GridView>
                                        <GridView.Columns>
                                            <GridViewColumn Header="" Width="35" CellTemplate="{StaticResource MotorTypeTemplate}"  />
                                            <GridViewColumn Header="ID" Width="50">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Label Content="{Binding ID}" HorizontalContentAlignment="Center"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="상태" Width="150" CellTemplate="{StaticResource StatusTemplate}"/>
                                        </GridView.Columns>
                                    </GridView>
                                </ListView.View>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </ListView.ItemContainerStyle>

                            </ListView>
                            <!--#endregion-->

                        </Grid>
                        <!--#endregion-->
                    </GroupBox>
                    <GroupBox Grid.Row="0" Grid.Column="1" Margin="5">
                        <!--#region 온실1-2구역 영역 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <!--ListView상단공간크기-->
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="60"/>
                                <RowDefinition Height ="*"/>
                            </Grid.RowDefinitions>

                            <!-- 구역 타이틀 -->
                            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" CornerRadius="3" Background="#34495e" Margin="0 3">
                                <TextBlock HorizontalAlignment="Center" Margin="0 3" Foreground="white" FontWeight="DemiBold">2구역</TextBlock>
                            </Border>

                            <!--#region 온실1-2구역 짝수 영역 -->

                            <Grid Grid.Row="1" Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="1*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Row="0" Grid.Column="0" CornerRadius="5" Grid.RowSpan="3" Background="#f39c12" Margin="5 0 0 2">
                                    <Label HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White">짝</Label>
                                </Border>
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="5 0 0 0">
                                    <Image Source="/images/oldmotor.png" Width="15" Height="15" ToolTip="기존모터"/>
                                    <Rectangle x:Name="rec_H1R2E_SOURCE_NETSTATUS" Width="10" Height="10" RadiusX="10" RadiusY="10" Margin="5 0 0 0" Fill="Gray"/>
                                    <TextBlock x:Name="H1R2E_lbl_old_ip" Margin="5 0 0 0">-</TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="5 0 0 0">
                                    <Image Source="/images/newmotor.png" Width="15" Height="15" ToolTip="신규모터"/>
                                    <Rectangle x:Name="rec_H1R2E_TARGET_NETSTATUS" Width="10" Height="10" RadiusX="10" RadiusY="10" Margin="5 0 0 0" Fill="Gray"/>
                                    <TextBlock x:Name="H1R2E_lbl_new_ip" Margin="5 0 0 0">-</TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="5 0 0 0">
                                    <TextBlock Width="15">┖</TextBlock>
                                    <Rectangle x:Name="rec_H1R2E_SID_NETSTATUS" Width="10" Height="10" RadiusX="10" RadiusY="10" Margin="5 0 0 0" Fill="Gray"/>
                                    <TextBlock x:Name="H1R2E_lbl_source" VerticalAlignment="Top" Margin="5 0 0 0" >-</TextBlock>
                                </StackPanel>
                                <Button x:Name="Btn_Settings_H1R2E" Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" VerticalAlignment="Top" Style="{StaticResource SettingsTemplate}"/>
                                <Button x:Name="Btn_Add_H1R2E" Grid.Row="1" Grid.Column="2" Grid.RowSpan="2" VerticalAlignment="Bottom" Style="{StaticResource AddTemplate}"/>
                            </Grid>

                            <ListView x:Name="LV_H1R2E" Grid.Row="2" Grid.Column="0" GridViewColumnHeader.Click="lvHeader_CLICK" MouseDoubleClick="Lv_DBClick" SizeChanged="ListView_SizeChanged">
                                <ListView.View>
                                    <GridView>
                                        <GridView.Columns>
                                            <GridViewColumn Header="" Width="35" CellTemplate="{StaticResource MotorTypeTemplate}"  />
                                            <GridViewColumn Header="ID" Width="50">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Label Content="{Binding ID}" HorizontalContentAlignment="Center"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="상태" Width="150" CellTemplate="{StaticResource StatusTemplate}"/>
                                        </GridView.Columns>
                                    </GridView>
                                </ListView.View>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>
                            <!--#endregion-->

                            <!--#region 온실1-2구역 홀수 영역 -->
                            <Grid Grid.Row="1" Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="1*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Row="0" Grid.Column="0" CornerRadius="5" Grid.RowSpan="3" Background="#2980b9" Margin="5 0 0 2">
                                    <Label HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White">홀</Label>
                                </Border>
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="5 0 0 0">
                                    <Image Source="/images/oldmotor.png" Width="15" Height="15" ToolTip="기존모터"/>
                                    <Rectangle x:Name="rec_H1R2O_SOURCE_NETSTATUS" Width="10" Height="10" RadiusX="10" RadiusY="10" Margin="5 0 0 0" Fill="Gray"/>
                                    <TextBlock x:Name="H1R2O_lbl_old_ip" Margin="5 0 0 0">-</TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="5 0 0 0">
                                    <Image Source="/images/newmotor.png" Width="15" Height="15" ToolTip="신규모터"/>
                                    <Rectangle x:Name="rec_H1R2O_TARGET_NETSTATUS" Width="10" Height="10" RadiusX="10" RadiusY="10" Margin="5 0 0 0" Fill="Gray"/>
                                    <TextBlock x:Name="H1R2O_lbl_new_ip" Margin="5 0 0 0">-</TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="5 0 0 0">
                                    <TextBlock Width="15">┖</TextBlock>
                                    <Rectangle x:Name="rec_H1R2O_SID_NETSTATUS" Width="10" Height="10" RadiusX="10" RadiusY="10" Margin="5 0 0 0" Fill="Gray"/>
                                    <TextBlock x:Name="H1R2O_lbl_source" VerticalAlignment="Top" Margin="5 0 0 0" >-</TextBlock>
                                </StackPanel>
                                <Button x:Name="Btn_Settings_H1R2O" Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" VerticalAlignment="Top" Style="{StaticResource SettingsTemplate}"/>
                                <Button x:Name="Btn_Add_H1R2O" Grid.Row="1" Grid.Column="2" Grid.RowSpan="2" VerticalAlignment="Bottom" Style="{StaticResource AddTemplate}"/>
                            </Grid>

                            <ListView x:Name="LV_H1R2O" Grid.Row="2" Grid.Column="1" GridViewColumnHeader.Click="lvHeader_CLICK" MouseDoubleClick="Lv_DBClick" SizeChanged="ListView_SizeChanged">

                                <ListView.View>
                                    <GridView>
                                        <GridView.Columns>
                                            <GridViewColumn Header="" Width="35" CellTemplate="{StaticResource MotorTypeTemplate}"  />
                                            <GridViewColumn Header="ID" Width="50">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Label Content="{Binding ID}" HorizontalContentAlignment="Center"/>
                                                    </DataTemplate>
